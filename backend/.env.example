# Copy to .env and set values for your own local TinyIoT instance.
# Keep oneM2M originators and simulation tokens server-side.
TINYIOT_BASE_URL=http://localhost:3000/TinyIoT
TINYIOT_WORKOUT_ORIGIN=
TINYIOT_CINDYPT_ORIGIN=
TINYIOT_REPETITION_RESOURCE=CindySense_AE/RepetitionCount
TINYIOT_RECOMMENDATIONS_RESOURCE=CindyPT_AE/AIRecommendations
CINDYSENSE_ENABLE_SIMULATION_WRITES=false
CINDYSENSE_SIMULATION_TOKEN=
TINYIOT_SIMULATION_ORIGIN=
