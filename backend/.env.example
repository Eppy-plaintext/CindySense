# Copy to .env and set values for your own local TinyIoT instance.
# Keep oneM2M originators and simulation tokens server-side.
# On the inspected local server, CDashboard reads RepetitionCount and CCindyPT
# reads WorkoutSummary, FitnessGoals, and AIRecommendations. Verify privileges
# for your own TinyIoT instance before setting these server-side values.
TINYIOT_BASE_URL=http://127.0.0.1:3001/TinyIoT
TINYIOT_WORKOUT_ORIGIN=
TINYIOT_DISCOVERY_ORIGIN=
TINYIOT_DISCOVERY_TTL_SECONDS=30
TINYIOT_GROUP_ORIGIN=
TINYIOT_GROUP_RESOURCE=CindySense_AE/WorkoutMonitoring_GRP
TINYIOT_WEBCAM_ORIGIN=CWebcam
# Dashboard webcam control requires the local MediaPipe Python and a verified,
CINDYSENSE_PERF_LOGGING=1
# non-admin publisher with CREATE/RETRIEVE on repetition and summary containers.
CINDYSENSE_WEBCAM_PYTHON=
CINDYSENSE_EVENT_ORIGIN=
CINDYSENSE_SUMMARY_ORIGIN=
TINYIOT_CINDYPT_ORIGIN=
TINYIOT_REPETITION_RESOURCE=CindySense_AE/RepetitionCount
TINYIOT_WORKOUT_SUMMARY_RESOURCE=CindySense_AE/WorkoutSummary
# Optional read-only history endpoint; verify this origin has TS/TSI RETRIEVE access.
TINYIOT_WORKOUT_TS_RESOURCE=CindySense_AE/WorkoutPerformance_TS
TINYIOT_WORKOUT_TS_READ_ORIGIN=CDashboard
TINYIOT_TARGET_PLAN_RESOURCE=CindyPT_AE/FitnessGoals
TINYIOT_RECOMMENDATIONS_RESOURCE=CindyPT_AE/AIRecommendations
TINYIOT_TRAINING_PLANS_RESOURCE=CindyPT_AE/TrainingPlans
TINYIOT_WORKOUT_SCHEDULE_RESOURCE=CindyPT_AE/WorkoutSchedule
TINYIOT_RECOVERY_RESOURCE=CindyPT_AE/RecoveryRecommendations
CINDYSENSE_ENABLE_SIMULATION_WRITES=false
# Development-only writes require a separately verified write origin and a
# private random token (32+ characters). Keep both unset by default.
CINDYSENSE_SIMULATION_TOKEN=
TINYIOT_SIMULATION_ORIGIN=

# Optional oneM2M subscriptions. Use a Windows host IP reachable from TinyIoT
# in WSL, with FastAPI bound to that interface (for example 0.0.0.0:8000).
# Generate a private random token of at least 32 characters and use it in both
# values. CAdmin can create subscriptions on the inspected CindySense containers;
# prefer a narrower existing origin if it has CREATE and RETRIEVE access.
CINDYSENSE_NOTIFICATION_TOKEN=
CINDYSENSE_NOTIFICATION_URL=
TINYIOT_SUBSCRIPTION_ORIGIN=
# Optional exact CSE origin sent in X-M2M-Origin on notification requests.
TINYIOT_NOTIFICATION_ORIGIN=

# Optional read-only ETSI MEC 028 WLAN client. Keep the sandbox URL/session
# endpoint in the local .env only; do not commit credentials or session paths.
MEC_ENABLED=false
MEC_WLAN_API_BASE_URL=
MEC_REQUEST_TIMEOUT_SECONDS=10
MEC_SERVICE_MGMT_API_BASE_URL=
MEC_SERVICE_DISCOVERY_TTL_SECONDS=30
MEC_SERVICE_DISCOVERY_ENABLED=false
MEC_ALLOW_CONFIGURED_FALLBACK=false

# Optional one-shot MEC 028 to oneM2M bridge. Keep the origin local and grant it
# least-privilege access to the dedicated MECBridge_AE hierarchy only.
MEC_BRIDGE_ENABLED=false
MEC_BRIDGE_ORIGIN=
MEC_BRIDGE_AE=MECBridge_AE
MEC_BRIDGE_WLAN_CONTAINER=WLANInformation

# MEC 028 subscriptions and callback receiver (disabled by default).
# Keep the token only in backend/.env; never commit it.
MEC_SUBSCRIPTIONS_ENABLED=false
MEC_NOTIFICATIONS_ENABLED=false
MEC_CALLBACK_TOKEN=
MEC_CALLBACK_PUBLIC_BASE_URL=
# Comma-separated MEC subscription identities approved for callbacks.
MEC_ALLOWED_SUBSCRIPTION_IDS=
