 #include <errno.h>
 
 #define MAX_CONNECTIONS 1024
+#define MAX_ACTIVE_WORKERS 64
 #define BUF_SIZE 65535
 #define MAX_REQUEST_HEADER_SIZE 16384
 #define QUEUE_SIZE 128
 
 int listenfd;
 int clients[MAX_CONNECTIONS];
+static pthread_mutex_t worker_count_lock = PTHREAD_MUTEX_INITIALIZER;
+static int active_workers = 0;
 static void start_server(const char *);
 static void respond(int);
+
+static int claim_worker(void)
+{
+    int claimed = 0;
+    pthread_mutex_lock(&worker_count_lock);
+    if (active_workers < MAX_ACTIVE_WORKERS) {
+        active_workers++;
+        claimed = 1;
+    }
+    pthread_mutex_unlock(&worker_count_lock);
+    return claimed;
+}
+
+static void release_worker(void)
+{
+    pthread_mutex_lock(&worker_count_lock);
+    active_workers--;
+    pthread_mutex_unlock(&worker_count_lock);
+}
+
+static void reject_busy(int fd)
+{
+    static const char response[] =
+        "HTTP/1.1 503 Service Unavailable\r\n"
+        "Connection: close\r\nX-M2M-RSC: 5000\r\n"
+        "Content-Length: 0\r\n\r\n";
+    send(fd, response, sizeof(response) - 1, MSG_NOSIGNAL);
+    close(fd);
+}
+
+static int send_all(int fd, const char *data, size_t length)
+{
+    while (length > 0) {
+        ssize_t sent = send(fd, data, length, MSG_NOSIGNAL);
+        if (sent < 0 && errno == EINTR)
+            continue;
+        if (sent <= 0)
+            return -1;
+        data += sent;
+        length -= (size_t)sent;
+    }
+    return 0;
+}
